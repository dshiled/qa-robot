# QA-Robot Environment Configuration (.env)
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# =============================================================================
# Server
# =============================================================================
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development

# =============================================================================
# AI / Gemini — REQUIRED for "qa-robot generate" and /api/generate
# Get a key at: https://aistudio.google.com/apikey
# =============================================================================
GEMINI_API_KEY=your-gemini-api-key-here

# =============================================================================
# Stripe Billing — REQUIRED for paid tiers and checkout
# Get keys at: https://dashboard.stripe.com/apikeys
# Webhook secret from: https://dashboard.stripe.com/webhooks
# =============================================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_FREE=price_free_monthly
STRIPE_PRICE_ID_PROFESSIONAL=price_professional_monthly
STRIPE_PRICE_ID_ENTERPRISE=price_enterprise_monthly

# =============================================================================
# Authentication (local email+password — always available)
# =============================================================================
# No config needed for local auth. Users register via /api/auth/register.
# First registered user becomes the team owner.

# =============================================================================
# CORS — SECURITY
# Default is SAME-ORIGIN ONLY (no Access-Control-Allow-Origin header emitted).
# Set a comma-separated allowlist to permit specific front-end origins.
# =============================================================================
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# =============================================================================
# SAML Single Sign-On — DISABLED, DO NOT CONFIGURE YET
# -----------------------------------------------------------------------------
# SSO routes are NOT mounted. The assertion validator did not verify XML
# signatures, so any POST to /saml/callback could have logged in as any user.
# The user store functions it needs (getUserByEmail/createUser/logAuthEvent)
# were also never implemented.
#
# To re-enable SSO you must:
#   1. Integrate a signature-verifying library (@node-saml/node-saml-passport
#      or xml-crypto) and replace the stub in saml.js.
#   2. Implement the missing user-store functions.
#   3. Flip SAML_IMPLEMENTATION_COMPLETE to true in saml.js.
#   4. Implement session handling (express-session is not currently used).
#
# Until then, do not fill in the SAML_* values below — they have no effect.
# =============================================================================
# SAML_ENTRY_POINT=https://your-idp.com/oauth/saml/acs
# SAML_ISSUER=http://localhost:3000/saml/metadata
# SAML_CERT=-----BEGIN CERTIFICATE-----\nMIID... (your IdP's signing certificate in PEM format) ...\n-----END CERTIFICATE-----
# SAML_IDP_SSO_URL=https://your-idp.com/oauth/saml/acs
# SAML_IDP_SLO_URL=https://your-idp.com/logout
# SAML_SP_ENTITY_ID=http://localhost:3000/saml/metadata
# SAML_NAME_ID_FORMAT=urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress
# SAML_ACS_URL=http://localhost:3000/saml/callback
# SAML_SLO_URL=http://localhost:3000/saml/logout
# SAML_SIGNATURE_ALG=rsa-sha256
# SAML_DIGEST_ALG=sha256

# =============================================================================
# CI / GitHub Integration — for PR decoration and status checks
# Get a PAT at: https://github.com/settings/tokens
#   Scopes needed: repo (for private repos) or public_repo
# =============================================================================
GITHUB_TOKEN=ghp_...
GITHUB_REPO_OWNER=your-org-or-username
GITHUB_REPO_NAME=your-repo-name

# =============================================================================
# Mobile / Appium — for Android device farm testing
# Appium is FREE and open-source. Install: npm install -g appium
# Start: appium --port 4723
# Android SDK: free from Google (developer.android.com/studio)
#   - No Apple Developer account needed for Android
#   - iOS testing needs $99/yr Apple Developer Program + Mac
# =============================================================================
APPIUM_PORT=4723
APPIUM_HOST=127.0.0.1
APPIUM_PLATFORM=android          # android | ios
APPIUM_DEVICE_NAME=Android_Emulator
APPIUM_APP_PATH=                 # auto-detected from upload, override if needed
ANDROID_SDK_ROOT=C:/Users/desti/AppData/Local/Android/Sdk
ANDROID_AVD=qr-test-avd

# =============================================================================
# Cloud Device Farm (optional — replace local Appium with cloud provider)
# BrowserStack:  https://www.browserstack.com/
# Sauce Labs:    https://saucelabs.com/
# LambdaTest:    https://www.lambdatest.com/
# =============================================================================
# Uncomment and fill ONE of these to use cloud devices instead of local Appium:
# BROWSERSTACK_USERNAME=browserstack_user
# BROWSERSTACK_ACCESS_KEY=browserstack_key
# SAUCE_USERNAME=sauce_user
# SAUCE_ACCESS_KEY=sauce_key

# =============================================================================
# Data Residency — optional multi-region support
# When set, tenant data is stored under the region subfolder.
# Regions are configured per-tenant in the team record.
# =============================================================================
DATA_RESIDENCY_ENABLED=false
DATA_RESIDENCY_REGIONS=us,eu
DEFAULT_REGION=us

# =============================================================================
# Rate Limiting (optional — protect API from abuse)
# =============================================================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# =============================================================================
# Feature Flags
# =============================================================================
FEATURE_AUDIT_LOG=true
FEATURE_SAML_SSO=true
FEATURE_DATA_RESIDENCY=false
FEATURE_COMPLIANCE_DASHBOARD=true
FEATURE_PROMPT_SAFETY=true
